\f0\fs24 \cf0 :root\{\
  --bg:#0f1115;\
  --fg:#e7e9ee;\
  --muted:#9aa0ac;\
  --card:#1a1d23;\
  --accent:#4f46e5;\
  --accent-weak:#3730a3;\
  --radius:14px;\
  --gap:1rem;\
  --font:system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;\
\}\
*\{box-sizing:border-box\}\
html,body\{height:100%\}\
body\{\
  margin:0;\
  background:var(--bg);\
  color:var(--fg);\
  font:16px/1.5 var(--font);\
\}\
h1,h2,h3\{margin:0 0 .6rem 0; font-weight:600\}\
small\{color:var(--muted)\}\
a\{color:var(--accent)\}\
.container\{\
  display:grid;\
  grid-template-columns: 320px 1fr;\
  gap:var(--gap);\
  padding:var(--gap);\
\}\
@media(max-width:900px)\{\
  .container\{\
    grid-template-columns: 1fr;\
  \}\
  aside.sidebar\{order:2\}\
\}\
.sidebar\{\
  position:sticky;\
  top:0;\
  align-self:flex-start;\
  background:var(--card);\
  padding:var(--gap);\
  border-radius:var(--radius);\
  box-shadow:0 0 0 1px rgba(255,255,255,.03), 0 8px 24px rgba(0,0,0,.2);\
\}\
.card\{\
  background:var(--card);\
  padding:var(--gap);\
  border-radius:var(--radius);\
  box-shadow:0 0 0 1px rgba(255,255,255,.03), 0 8px 24px rgba(0,0,0,.2);\
\}\
.app-header\{\
  display:flex;\
  align-items:center;\
  justify-content:space-between;\
  padding:1rem var(--gap);\
  border-bottom:1px solid rgba(255,255,255,.05);\
\}\
.panel\{\
  padding:0 var(--gap) var(--gap);\
  background:#13161b;\
  border-bottom:1px solid rgba(255,255,255,.05);\
\}\
.hidden\{display:none\}\
.field\{\
  display:flex;\
  flex-direction:column;\
  gap:.35rem;\
  margin-bottom:.75rem;\
\}\
input,select,button\{\
  border:1px solid rgba(255,255,255,.08);\
  background:#111319;\
  color:var(--fg);\
  border-radius:10px;\
  padding:.6rem .7rem;\
  font:inherit;\
\}\
input:focus,select:focus\{\
  outline:none;\
  border-color:var(--accent);\
  box-shadow:0 0 0 2px rgba(79,70,229,.15);\
\}\
button\{\
  cursor:pointer;\
  border:none;\
\}\
button.primary\{\
  background:var(--accent);\
\}\
button.primary:hover\{background:var(--accent-weak)\}\
button.ghost\{\
  background:transparent;\
  border:1px solid rgba(255,255,255,.08);\
\}\
.actions\{\
  display:flex;\
  gap:.5rem;\
  margin-top:.5rem;\
\}\
#results\{\
  display:grid;\
  grid-template-columns:repeat(auto-fill,minmax(280px,1fr));\
  gap:var(--gap);\
  margin-top:var(--gap);\
\}\
.product .score\{\
  width:48px;height:48px;border-radius:50%;\
  display:flex;align-items:center;justify-content:center;\
  background:#111319;font-weight:700;margin-bottom:.5rem;\
\}\
.product .title\{\
  margin-bottom:.25rem;\
\}\
.product .meta\{\
  color:var(--muted);font-size:.85rem;margin-bottom:.5rem;\
\}\
.product .nutrition\{\
  list-style:none;margin:0 0 .75rem 0;padding:0;\
  font-size:.85rem;color:var(--muted);\
\}\
.badge\{\
  display:inline-block;padding:.1rem .4rem;border-radius:999px;\
  background:rgba(255,255,255,.06);margin-right:.25rem;font-size:.75rem;\
\}\
}